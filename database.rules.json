{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",

        "hostId": {
          ".validate": "newData.isString()"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|inProgress|finished)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "turnDeadline": {
          ".validate": "newData.isNumber()"
        },

        "players": {
          "$playerId": {
            ".write": "auth != null && (auth.uid == $playerId || root.child('rooms').child($roomCode).child('hostId').val() == auth.uid)",
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": { ".validate": "newData.isString() && newData.val() == $playerId" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "isHost": { ".validate": "newData.isBoolean()" },
            "connected": { ".validate": "newData.isBoolean()" }
          }
        },

        "gameState": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('hostId').val() == auth.uid",
          ".validate": "newData.hasChildren(['players', 'currentPlayerIndex', 'status', 'phase'])",
          "currentPlayerIndex": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.isString()" },
          "phase": { ".validate": "newData.isString()" },
          "players": {
            ".validate": "newData.isList()"
          }
        },

        "actions": {
          "$actionId": {
            ".write": "auth != null && newData.child('playerId').val() == auth.uid",
            ".validate": "newData.hasChildren(['type', 'playerId'])",
            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(roll_dice|buy_property|decline_buy|build_house|auction_bid|auction_pass|end_turn|chat)$/)"

            },
            "playerId": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            }
          }
        }
      }
    }
  }
}
